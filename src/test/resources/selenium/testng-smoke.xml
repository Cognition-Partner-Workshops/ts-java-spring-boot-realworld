<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenium Smoke Test">

    <test name="Setup Verification">
        <classes>
            <class name="io.spring.selenium.tests.SeleniumSetupTest"/>
        </classes>
    </test>

    <test name="Critical Path">
        <classes>
            <class name="io.spring.selenium.tests.CriticalPathSmokeTest"/>
        </classes>
    </test>

    <test name="Reading Time Badge">
        <classes>
            <class name="io.spring.selenium.tests.ReadingTimeBadgeTest"/>
        </classes>
    </test>

</suite>
